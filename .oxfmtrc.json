{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "coverage/**",
    ".ladle/**",
    "**/*.min.js",
    "package-lock.json",
    "CHANGELOG.md",
    ".release-please-manifest.json"
  ]
}
